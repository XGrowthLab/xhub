[Unit]
Description=XHub Compose release updater
Requires=docker.service
After=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/xhub
StateDirectory=xhub-updater
StateDirectoryMode=0700
RuntimeDirectory=xhub-updater
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/etc/xhub-updater.env
ExecStart=/usr/bin/python3 -B /opt/xhub-updater/update_agent.py --compose /opt/xhub/docker-compose.yml --project xhub --state-dir /var/lib/xhub-updater --socket /run/xhub-updater/agent.sock
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
